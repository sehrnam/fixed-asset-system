# ============================================================
# Fixed Asset Accounting Workbook - Environment Configuration
# ============================================================
# Copy this file to `.env` and adjust. Never commit `.env` to git.
#
#   backend/.env     <- read by the backend (pydantic-settings)
#
# The development defaults below work as-is.
# For production, see comments marked PROD.
# ============================================================

# --- Application ---
ENVIRONMENT=development
APP_NAME=Fixed Asset Accounting Workbook

# --- Database ---
# DEV: local SQLite file (created automatically by `python -m app.cli init-db`)
DATABASE_URL=sqlite:///./fixed_assets.db
# PROD (PostgreSQL-ready):
#   pip install psycopg2-binary
#   DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/fixed_assets

# --- Security ---
# PROD: generate a long random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-me-with-a-long-random-string

COOKIE_NAME=fas_session
# DEV: leave false so cookies work over http://localhost
# PROD: set to true (HTTPS only)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
SESSION_LIFETIME_HOURS=12

# --- CORS ---
# Comma-separated allowlist. NEVER use "*" in production.
CORS_ORIGINS=http://localhost:5173
# PROD example:
#   CORS_ORIGINS=https://app.yourbank.example

# --- Currency ---
# Configurable; GHS is the demo default.
CURRENCY=GHS

# --- Login rate limiting ---
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# --- Upload / import safety ---
# Max size of an uploaded XLSX file, in bytes (5000000 = 5 MB)
MAX_UPLOAD_BYTES=5000000
# Comma-separated MIME types accepted for XLSX uploads
ALLOWED_XLSX_MIME_TYPES=application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/octet-stream

# --- Self-healing / free-tier deployment ---
# When true, the app ensures the database has working users and demo data
# on every startup. Required on free-tier hosts where the filesystem is
# ephemeral (Render, Railway, Fly, etc.).
#
# Local development: leave false.
# Free-tier demo deployment: set AUTO_BOOTSTRAP=true.
AUTO_BOOTSTRAP=false