# ============================================================
# Frontend environment (Vite)
# ============================================================
# Copy to `.env.local` for local overrides. Never commit `.env.local`.
#
# VITE_API_BASE_URL: the backend URL WITHOUT the trailing /api.
# The frontend appends /api automatically.
#
# Local development: leave unset or empty. Vite's dev server proxies
#   /api/*  ->  http://localhost:8000
# via vite.config.ts.
#
# Production (Netlify):
#   VITE_API_BASE_URL=https://your-api.onrender.com

# VITE_API_BASE_URL=